{
  "name": "pwa-install-assistant",
  "version": "0.1.0",
  "description": "Get your web app onto the home screen: an install assistant that points at the real button on every phone and tablet, and moves on by itself where the browser allows. Vanilla, React, Vue, Svelte, Solid, Angular, Web Component.",
  "keywords": [
    "pwa",
    "install",
    "add-to-home-screen",
    "a2hs",
    "beforeinstallprompt",
    "ios",
    "safari",
    "android",
    "web-app",
    "react",
    "vue",
    "svelte",
    "solid",
    "angular",
    "web-component"
  ],
  "license": "MIT",
  "author": "Mauro Serrano",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mauroz9/pwa-install-assistant.git"
  },
  "homepage": "https://mauroz9.github.io/pwa-install-assistant/",
  "bugs": "https://github.com/mauroz9/pwa-install-assistant/issues",
  "type": "module",
  "sideEffects": [
    "./dist/element.js",
    "./dist/element.cjs",
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./headless": {
      "types": "./dist/headless.d.ts",
      "import": "./dist/headless.js",
      "require": "./dist/headless.cjs"
    },
    "./qr": {
      "types": "./dist/qr.d.ts",
      "import": "./dist/qr.js",
      "require": "./dist/qr.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js",
      "require": "./dist/vue.cjs"
    },
    "./svelte": {
      "types": "./dist/svelte.d.ts",
      "import": "./dist/svelte.js",
      "require": "./dist/svelte.cjs"
    },
    "./solid": {
      "types": "./dist/solid.d.ts",
      "import": "./dist/solid.js",
      "require": "./dist/solid.cjs"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js",
      "require": "./dist/element.cjs"
    },
    "./locales/en": {
      "types": "./dist/locales/en.d.ts",
      "import": "./dist/locales/en.js",
      "require": "./dist/locales/en.cjs"
    },
    "./locales/es": {
      "types": "./dist/locales/es.d.ts",
      "import": "./dist/locales/es.js",
      "require": "./dist/locales/es.cjs"
    },
    "./locales/pt": {
      "types": "./dist/locales/pt.d.ts",
      "import": "./dist/locales/pt.js",
      "require": "./dist/locales/pt.cjs"
    },
    "./locales/fr": {
      "types": "./dist/locales/fr.d.ts",
      "import": "./dist/locales/fr.js",
      "require": "./dist/locales/fr.cjs"
    },
    "./locales/de": {
      "types": "./dist/locales/de.d.ts",
      "import": "./dist/locales/de.js",
      "require": "./dist/locales/de.cjs"
    },
    "./locales/it": {
      "types": "./dist/locales/it.d.ts",
      "import": "./dist/locales/it.js",
      "require": "./dist/locales/it.cjs"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.es.md",
    "LICENSE"
  ],
  "workspaces": [
    "demo",
    "examples/*"
  ],
  "scripts": {
    "build": "tsup && node scripts/postbuild.mjs",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "size": "node scripts/size.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "demo": "npm run build && npm run dev -w demo",
    "test:e2e": "playwright test",
    "prepare": "npm run build",
    "build:examples": "for ex in html next nuxt sveltekit astro remix solid angular; do npm run build -w examples/$ex || exit 1; done",
    "release:notes": "node scripts/release-notes.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18",
    "solid-js": ">=1.6",
    "svelte": ">=4",
    "vue": ">=3.2"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "solid-js": "^1.9.18",
    "svelte": "^5.57.3",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "vue": "^3.5.45"
  }
}
